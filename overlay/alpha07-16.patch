+private fun StartupDestination.toMainTab(): MainTab = when (this) {
+    StartupDestination.HOME -> MainTab.HOME
+    StartupDestination.PANEL -> MainTab.PANEL
+    StartupDestination.TOOLS -> MainTab.TOOLS
+    StartupDestination.SETTINGS -> MainTab.SETTINGS
+}
+
+private fun launchConfigPicker(launcher: androidx.activity.result.ActivityResultLauncher<Array<String>>) {
+    launcher.launch(
+        arrayOf(
+            "application/x-yaml",
+            "application/yaml",
+            "text/yaml",
+            "text/x-yaml",
+            "text/plain",
+            "application/octet-stream",
+        ),
+    )
+}
