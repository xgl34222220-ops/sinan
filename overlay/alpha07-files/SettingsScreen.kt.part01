                            summary = "显示透明代理运行状态通知",
                            icon = Icons.Rounded.Notifications,
                            checked = state.behavior.notificationsEnabled,
                            onCheckedChange = { value -> onUpdateBehavior { it.copy(notificationsEnabled = value) } },
                        )
                        MiuixDivider(startPadding = 72.dp)
                        MiuixPreferenceRow(
                            title = "通知详细设置",
                            summary = "配置通知内容、权限和系统通知渠道",
                            icon = Icons.Rounded.Tune,
                            onClick = onOpenNotificationSettings,
                        )
                        MiuixDivider(startPadding = 72.dp)
                        MiuixSwitchRow(
                            title = "显示状态栏面板入口",
                            summary = "在通知栏保留司南快捷入口",
                            checked = state.behavior.statusPanelEntry,
                            onCheckedChange = { value -> onUpdateBehavior { it.copy(statusPanelEntry = value) } },
                        )
                        MiuixDivider()
                        MiuixSwitchRow(
                            title = "启动时打开面板",
                            summary = "启动应用后直接进入指定面板",
                            checked = state.behavior.openPanelOnStart,
                            onCheckedChange = { value -> onUpdateBehavior { it.copy(openPanelOnStart = value) } },
                        )
                        MiuixDivider()
                        MiuixPreferenceRow(
                            title = "启动面板",
                            value = startupLabel(state.behavior.startupDestination),
                            enabledValueColor = true,
                            onClick = { destinationDialog = true },
                        )
                    }
                }
            }

            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixPreferenceRow(
                            title = "基础代理配置",
                            summary = "IPv6、UDP、国内地址绕过与开机脚本",
                            icon = Icons.Rounded.Tune,
                            onClick = onOpenProxy,
                        )
                        MiuixDivider(startPadding = 72.dp)
                        MiuixPreferenceRow(
                            title = "应用分流",
                            summary = "按应用设置核心、白名单或黑名单模式",
                            icon = Icons.Rounded.Apps,
                            value = appModeLabel(state.appMode),
                            onClick = onOpenApps,
                        )
                        MiuixDivider(startPadding = 72.dp)
                        MiuixPreferenceRow(
                            title = "主题设置",
                            summary = "Miuix / Material3、Monet、模糊、底栏和动画",
                            icon = Icons.Rounded.Palette,
                            value = if (state.appearance.uiStyle == UiStyle.MIUIX) "Miuix" else "Material3",
                            onClick = onOpenAppearance,
                        )
                    }
                }
            }

            item {
                MiuixCard(strong = true) {
                    MiuixPreferenceRow(
                        title = "关于",
                        summary = "司南 · Root 透明代理控制器",
                        icon = Icons.Rounded.Info,
                        value = BuildConfig.VERSION_NAME.removeSuffix("-debug"),
                        showArrow = false,
                    )
                }
            }
        }
    }

    if (destinationDialog) {
        ChoiceDialog(
            title = "启动面板",
            options = StartupDestination.entries.map { it to startupLabel(it) },
            selected = state.behavior.startupDestination,
            onDismiss = { destinationDialog = false },
            onSelect = { value ->
                destinationDialog = false
                onUpdateBehavior { it.copy(startupDestination = value) }
            },
        )
    }
}

@Composable
fun AppearanceSettingsScreen(
    appearance: AppearanceState,
    onBack: () -> Unit,
    onUiStyle: (UiStyle) -> Unit,
    onThemeMode: (ThemeMode) -> Unit,
    onMonet: (Boolean) -> Unit,
    onAmoled: (Boolean) -> Unit,
    onColorStyle: (ColorStyle) -> Unit,
    onColorStandard: (ColorStandard) -> Unit,
    onAccentName: (String) -> Unit,
    onBlur: (Boolean) -> Unit,
    onFloatingDock: (Boolean) -> Unit,
    onGlass: (Boolean) -> Unit,
    onBottomTransition: (Boolean) -> Unit,
    onPredictiveBack: (Boolean) -> Unit,
    onHighRefresh: (Boolean) -> Unit,
) {
    var dialog by remember { mutableStateOf<String?>(null) }
    MiuixPage(
        title = "主题设置",
        onBack = onBack,
        contentPadding = PaddingValues(16.dp, 8.dp, 16.dp, 30.dp),
    ) {
        LazyColumn(
            modifier = Modifier.weight(1f),
            verticalArrangement = Arrangement.spacedBy(12.dp),
        ) {
            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixPreferenceRow(
                            title = "界面风格",
                            value = if (appearance.uiStyle == UiStyle.MIUIX) "Miuix" else "Material3",
                            enabledValueColor = true,
                            onClick = { dialog = "ui" },
                        )
                        MiuixDivider()
                        MiuixPreferenceRow(
                            title = "主题模式",
                            value = themeModeLabel(appearance.themeMode),
