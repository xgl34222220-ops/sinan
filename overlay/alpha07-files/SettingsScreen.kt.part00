@Composable
fun SettingsScreen(
    state: SinanUiState,
    onBootAutoStart: (Boolean) -> Unit,
    onUpdateBehavior: ((AppBehaviorState) -> AppBehaviorState) -> Unit,
    onOpenNotificationSettings: () -> Unit,
    onOpenProxy: () -> Unit,
    onOpenApps: () -> Unit,
    onOpenAppearance: () -> Unit,
) {
    var destinationDialog by remember { mutableStateOf(false) }
    MiuixPage(title = "设置") {
        LazyColumn(
            modifier = Modifier.weight(1f),
            contentPadding = PaddingValues(bottom = 12.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
        ) {
            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixSwitchRow(
                            title = "开机自启",
                            summary = "安装 Root 开机脚本，开机后自动启动透明代理",
                            icon = Icons.Rounded.PowerSettingsNew,
                            checked = state.settings.bootAutoStart,
                            onCheckedChange = onBootAutoStart,
                        )
                        MiuixDivider(startPadding = 72.dp)
                        MiuixSwitchRow(
                            title = "加速下载",
                            summary = "为下载远程资源启用加速通道",
                            icon = Icons.Rounded.Download,
                            checked = state.behavior.acceleratedDownload,
                            onCheckedChange = { value -> onUpdateBehavior { it.copy(acceleratedDownload = value) } },
                        )
                        if (state.behavior.acceleratedDownload) {
                            Surface(
                                modifier = Modifier.fillMaxWidth().padding(start = 72.dp, end = 16.dp, bottom = 14.dp),
                                shape = RoundedCornerShape(15.dp),
                                color = MaterialTheme.colorScheme.primary.copy(alpha = .10f),
                            ) {
                                Text(
                                    state.behavior.mirrorUrl,
                                    modifier = Modifier.padding(horizontal = 13.dp, vertical = 10.dp),
                                    color = MaterialTheme.colorScheme.primary,
                                    fontSize = 11.5.sp,
                                    maxLines = 2,
                                    overflow = TextOverflow.Ellipsis,
                                )
                            }
                        }
                    }
                }
            }

            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixSwitchRow(
                            title = "通知",
