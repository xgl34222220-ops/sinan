        containerColor = tokens.elevatedCard,
        title = { Text(title, color = tokens.textPrimary, fontSize = 22.sp, fontWeight = FontWeight.Black) },
        text = {
            Column {
                options.forEach { (value, label) ->
                    Row(
                        modifier = Modifier.fillMaxWidth().clickable { onSelect(value) }.padding(vertical = 13.dp),
                        verticalAlignment = Alignment.CenterVertically,
                    ) {
                        Text(
                            label,
                            modifier = Modifier.weight(1f),
                            color = if (value == selected) MaterialTheme.colorScheme.primary else tokens.textPrimary,
                            fontSize = 16.sp,
                            fontWeight = if (value == selected) FontWeight.Bold else FontWeight.SemiBold,
                        )
                        if (value == selected) Text("✓", color = MaterialTheme.colorScheme.primary, fontSize = 22.sp, fontWeight = FontWeight.Black)
                    }
                }
            }
        },
        confirmButton = {},
        dismissButton = { TextButton(onClick = onDismiss) { Text("取消") } },
    )
}

@Composable
fun BasicProxySettingsScreen(
    state: SinanUiState,
    onBack: () -> Unit,
    onUpdateSettings: ((RuntimeSettings) -> RuntimeSettings) -> Unit,
    onSave: () -> Unit,
) {
    MiuixPage(
        title = "基础代理配置",
        onBack = onBack,
        contentPadding = PaddingValues(16.dp, 10.dp, 16.dp, 34.dp),
    ) {
        LazyColumn(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(12.dp)) {
            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixSwitchRow(
                            title = "IPv6",
                            summary = "允许透明代理处理 IPv6 流量",
                            checked = state.settings.ipv6Enabled,
                            onCheckedChange = { value -> onUpdateSettings { it.copy(ipv6Enabled = value) } },
                        )
                        MiuixDivider()
                        MiuixSwitchRow(
                            title = "UDP / QUIC",
                            summary = "代理 UDP，并同步 QUIC 设置",
                            checked = state.settings.proxyUdp,
                            onCheckedChange = { value -> onUpdateSettings { it.copy(proxyUdp = value) } },
                        )
                        MiuixDivider()
                        MiuixSwitchRow(
                            title = "自动覆写",
                            summary = "将 App 设置同步到后端数据库并重新生成规则",
                            checked = true,
                            onCheckedChange = {},
                        )
                        MiuixDivider()
                        MiuixSwitchRow(
                            title = "绕过中国大陆 IP",
                            summary = "国内目标地址直接连接",
                            checked = state.settings.bypassCn,
                            onCheckedChange = { value -> onUpdateSettings { it.copy(bypassCn = value) } },
                        )
                    }
                }
            }
            item {
                MiuixFilledButton(
                    text = if (state.busy) "正在保存…" else "保存并应用",
                    onClick = onSave,
                    enabled = state.settingsLoaded && !state.busy,
                )
            }
        }
    }
}

private fun appModeLabel(mode: String): String = when (mode) {
    "whitelist" -> "白名单"
    "blacklist" -> "黑名单"
    else -> "核心规则"
}

private fun startupLabel(destination: StartupDestination): String = when (destination) {
    StartupDestination.HOME -> "首页"
    StartupDestination.PANEL -> "面板"
    StartupDestination.TOOLS -> "工具"
    StartupDestination.SETTINGS -> "设置"
}

private fun themeModeLabel(mode: ThemeMode): String = when (mode) {
    ThemeMode.SYSTEM -> "跟随系统"
    ThemeMode.LIGHT -> "浅色"
    ThemeMode.DARK -> "深色"
}

private fun colorStyleLabel(style: ColorStyle): String = when (style) {
    ColorStyle.VIBRANT -> "Vibrant"
    ColorStyle.EXPRESSIVE -> "Expressive"
    ColorStyle.TONAL -> "Tonal Spot"
    ColorStyle.NEUTRAL -> "Neutral"
}

private fun colorStandardLabel(standard: ColorStandard): String = when (standard) {
    ColorStandard.MATERIAL_2021 -> "Material 3 2021"
    ColorStandard.MATERIAL_2025 -> "Material 3 2025"
}
