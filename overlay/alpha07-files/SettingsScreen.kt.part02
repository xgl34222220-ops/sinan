                            enabledValueColor = true,
                            onClick = { dialog = "theme" },
                        )
                    }
                }
            }

            item {
                MiuixSwitchRowCard(
                    title = "深色使用纯黑背景",
                    checked = appearance.amoledBlack,
                    onCheckedChange = onAmoled,
                )
            }

            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixSwitchRow(
                            title = "使用 Monet 取色",
                            checked = appearance.monetEnabled,
                            onCheckedChange = onMonet,
                        )
                        MiuixDivider()
                        MiuixPreferenceRow(
                            title = "色彩风格",
                            value = colorStyleLabel(appearance.colorStyle),
                            valuePrefix = { ColorDots() },
                            enabledValueColor = true,
                            onClick = { dialog = "color_style" },
                        )
                        MiuixDivider()
                        MiuixPreferenceRow(
                            title = "色彩标准",
                            value = colorStandardLabel(appearance.colorStandard),
                            enabledValueColor = true,
                            onClick = { dialog = "color_standard" },
                        )
                        MiuixDivider()
                        MiuixPreferenceRow(
                            title = "强调色",
                            value = appearance.accentName,
                            valuePrefix = { ColorDots() },
                            enabledValueColor = true,
                            onClick = { dialog = "accent" },
                        )
                    }
                }
            }

            item {
                MiuixCard(strong = true) {
                    Column {
                        MiuixSwitchRow(title = "模糊效果", checked = appearance.blurEnabled, onCheckedChange = onBlur)
                        MiuixDivider()
                        MiuixSwitchRow(title = "悬浮底栏", checked = appearance.floatingDock, onCheckedChange = onFloatingDock)
                        MiuixDivider()
                        MiuixSwitchRow(title = "底栏液态玻璃效果", checked = appearance.glassEnabled, onCheckedChange = onGlass)
                        MiuixDivider()
                        MiuixSwitchRow(title = "预期性返回动画", checked = appearance.predictiveBack, onCheckedChange = onPredictiveBack)
                        MiuixDivider()
                        MiuixSwitchRow(title = "底栏切换动画", checked = appearance.bottomBarTransition, onCheckedChange = onBottomTransition)
                        MiuixDivider()
                        MiuixSwitchRow(
                            title = "高刷新率",
                            summary = "优先请求当前分辨率下最高刷新率",
                            icon = Icons.Rounded.Speed,
                            checked = appearance.highRefreshRate,
                            onCheckedChange = onHighRefresh,
                        )
                    }
                }
            }
            item { Spacer(Modifier.height(8.dp)) }
        }
    }

    when (dialog) {
        "ui" -> ChoiceDialog(
            title = "界面风格",
            options = listOf(UiStyle.MATERIAL3 to "Material3", UiStyle.MIUIX to "Miuix"),
            selected = appearance.uiStyle,
            onDismiss = { dialog = null },
            onSelect = { dialog = null; onUiStyle(it) },
        )
        "theme" -> ChoiceDialog(
            title = "主题模式",
            options = ThemeMode.entries.map { it to themeModeLabel(it) },
            selected = appearance.themeMode,
            onDismiss = { dialog = null },
            onSelect = { dialog = null; onThemeMode(it) },
        )
        "color_style" -> ChoiceDialog(
            title = "色彩风格",
            options = ColorStyle.entries.map { it to colorStyleLabel(it) },
            selected = appearance.colorStyle,
            onDismiss = { dialog = null },
            onSelect = { dialog = null; onColorStyle(it) },
        )
        "color_standard" -> ChoiceDialog(
            title = "色彩标准",
            options = ColorStandard.entries.map { it to colorStandardLabel(it) },
            selected = appearance.colorStandard,
            onDismiss = { dialog = null },
            onSelect = { dialog = null; onColorStandard(it) },
        )
        "accent" -> ChoiceDialog(
            title = "强调色",
            options = listOf("默认", "蓝色", "紫色", "绿色", "橙色").map { it to it },
            selected = appearance.accentName,
            onDismiss = { dialog = null },
            onSelect = { dialog = null; onAccentName(it) },
        )
    }
}

@Composable
private fun MiuixSwitchRowCard(title: String, checked: Boolean, onCheckedChange: (Boolean) -> Unit) {
    MiuixCard(strong = true) {
        MiuixSwitchRow(title = title, checked = checked, onCheckedChange = onCheckedChange)
    }
}

@Composable
private fun ColorDots() {
    Row(horizontalArrangement = Arrangement.spacedBy(3.dp), verticalAlignment = Alignment.CenterVertically) {
        listOf(Color(0xFF1769D2), Color(0xFFAEB4C4), Color(0xFFC9B7E8)).forEach { color ->
            Box(Modifier.size(8.dp).background(color, CircleShape))
        }
    }
}

@Composable
private fun <T> ChoiceDialog(
    title: String,
    options: List<Pair<T, String>>,
    selected: T,
    onDismiss: () -> Unit,
    onSelect: (T) -> Unit,
) {
    val tokens = LocalMiuixTokens.current
    AlertDialog(
        onDismissRequest = onDismiss,
        shape = RoundedCornerShape(28.dp),
