+    fun wifiMatchSettings(): WifiMatchSettings = withDatabase { db ->
+        val base = db.rawQuery(
+            "SELECT network_control_enabled,use_on_wifi_disconnect,use_on_wifi_connect,enable_ssid_matching,enable_network_control_log,list_mode FROM wifi_match_settings WHERE id=1",
+            null,
+        ).use { cursor ->
+            if (!cursor.moveToFirst()) WifiMatchSettings() else WifiMatchSettings(
+                enabled = cursor.getInt(0) != 0,
+                useOnDisconnect = cursor.getInt(1) != 0,
+                useOnConnect = cursor.getInt(2) != 0,
+                ssidMatching = cursor.getInt(3) != 0,
+                logEnabled = cursor.getInt(4) != 0,
+                listMode = cursor.getString(5).orEmpty().ifBlank { "blacklist" },
+            )
+        }
+        base.copy(
+            ssids = readStringList(db, "wifi_match_ssids"),
+            bssids = readStringList(db, "wifi_match_bssids"),
+        )
+    }
+
+    fun saveWifiMatchSettings(settings: WifiMatchSettings) = withDatabase { db ->
+        db.beginTransaction()
+        try {
+            val values = ContentValues().apply {
+                put("network_control_enabled", if (settings.enabled) 1 else 0)
+                put("use_on_wifi_disconnect", if (settings.useOnDisconnect) 1 else 0)
+                put("use_on_wifi_connect", if (settings.useOnConnect) 1 else 0)
+                put("enable_ssid_matching", if (settings.ssidMatching) 1 else 0)
+                put("enable_network_control_log", if (settings.logEnabled) 1 else 0)
+                put("list_mode", settings.listMode)
+            }
+            db.update("wifi_match_settings", values, "id=1", null)
+            replaceStringList(db, "wifi_match_ssids", settings.ssids)
+            replaceStringList(db, "wifi_match_bssids", settings.bssids)
+            db.setTransactionSuccessful()
+        } finally { db.endTransaction() }
+    }
+
