+    private fun readStringList(db: SQLiteDatabase, table: String): List<String> = buildList {
+        db.rawQuery("SELECT value FROM $table ORDER BY id", null).use { cursor ->
+            while (cursor.moveToNext()) cursor.getString(0)?.trim()?.takeIf { it.isNotEmpty() }?.let(::add)
+        }
+    }
+
+    private fun replaceStringList(db: SQLiteDatabase, table: String, values: List<String>) {
+        db.delete(table, null, null)
+        values.map(String::trim).filter(String::isNotEmpty).distinct().forEach { value ->
+            db.insertOrThrow(table, null, ContentValues().apply { put("value", value) })
+        }
+    }
