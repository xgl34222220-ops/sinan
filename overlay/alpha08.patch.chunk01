diff -ruN alpha07_src/app/src/main/assets/box/sing-box/config.json alpha08_src/app/src/main/assets/box/sing-box/config.json
--- alpha07_src/app/src/main/assets/box/sing-box/config.json	1970-01-01 00:00:00.000000000 +0000
+++ alpha08_src/app/src/main/assets/box/sing-box/config.json	2026-07-31 08:11:01.261337787 +0000
@@ -0,0 +1,40 @@
+{
+  "log": { "level": "info", "timestamp": true },
+  "dns": {
+    "servers": [
+      { "tag": "remote", "address": "https://1.1.1.1/dns-query" }
+    ],
+    "final": "remote"
+  },
+  "inbounds": [
+    {
+      "type": "mixed",
+      "tag": "mixed-in",
+      "listen": "127.0.0.1",
+      "listen_port": 7890
+    },
+    {
+      "type": "tproxy",
+      "tag": "tproxy-in",
+      "listen": "::",
+      "listen_port": 9898,
+      "network": "tcp"
+    },
+    {
+      "type": "redirect",
+      "tag": "redirect-in",
+      "listen": "::",
+      "listen_port": 9797
+    }
+  ],
+  "outbounds": [
+    { "type": "direct", "tag": "direct" }
+  ],
+  "route": { "final": "direct" },
+  "experimental": {
+    "clash_api": {
+      "external_controller": "127.0.0.1:9090",
+      "external_ui": "ui"
+    }
+  }
+}
diff -ruN alpha07_src/app/src/main/assets/box/v2fly/config.json alpha08_src/app/src/main/assets/box/v2fly/config.json
