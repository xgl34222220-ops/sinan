+@Composable
+fun CnipSettingsScreen(
+    state: SinanUiState,
+    onBack: () -> Unit,
+    onUpdate: ((CnipSettings) -> CnipSettings) -> Unit,
+    onSave: () -> Unit,
+    onUpdateLists: () -> Unit,
+) {
+    val value = state.networkTools.cnip
+    MiuixPage(title = "CNIP 设置", onBack = onBack, contentPadding = PaddingValues(16.dp, 8.dp, 16.dp, 30.dp)) {
+        LazyColumn(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            item {
+                MiuixCard(strong = true) {
+                    Column {
+                        MiuixSwitchRow("启用 CNIP 绕过", value.enabled, { checked -> onUpdate { it.copy(enabled = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("更新 IPv4 地址库", value.ipv4Enabled, { checked -> onUpdate { it.copy(ipv4Enabled = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("更新 IPv6 地址库", value.ipv6Enabled, { checked -> onUpdate { it.copy(ipv6Enabled = checked) } })
+                        MiuixDivider()
+                        MiuixPreferenceRow(
+                            title = "CNIP 模式",
+                            value = value.mode,
+                            enabledValueColor = true,
+                            onClick = { onUpdate { it.copy(mode = if (it.mode == "ipset") "nftset" else "ipset") } },
+                        )
+                    }
+                }
+            }
+            item { SingleLineEditor("IPv4 数据源", value.ipv4Url) { text -> onUpdate { it.copy(ipv4Url = text) } } }
+            item { SingleLineEditor("IPv6 数据源", value.ipv6Url) { text -> onUpdate { it.copy(ipv6Url = text) } } }
+            item {
+                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    MiuixFilledButton("保存设置", onSave, Modifier.weight(1f), enabled = !state.networkTools.saving)
+                    MiuixFilledButton(
+                        if (state.networkTools.cnipUpdating) "更新中…" else "立即更新",
+                        onUpdateLists,
+                        Modifier.weight(1f),
+                        enabled = !state.networkTools.cnipUpdating,
+                    )
+                }
+            }
+        }
+    }
+}
