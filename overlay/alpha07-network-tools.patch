+@Composable
+fun WifiMatchScreen(
+    state: SinanUiState,
+    onBack: () -> Unit,
+    onUpdate: ((WifiMatchSettings) -> WifiMatchSettings) -> Unit,
+    onSave: () -> Unit,
+) {
+    val value = state.networkTools.wifi
+    MiuixPage(title = "Wi-Fi 匹配", onBack = onBack, contentPadding = PaddingValues(16.dp, 8.dp, 16.dp, 30.dp)) {
+        LazyColumn(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            item {
+                MiuixCard(strong = true) {
+                    Column {
+                        MiuixSwitchRow("启用网络控制", value.enabled, { checked -> onUpdate { it.copy(enabled = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("Wi-Fi 连接时应用", value.useOnConnect, { checked -> onUpdate { it.copy(useOnConnect = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("Wi-Fi 断开时应用", value.useOnDisconnect, { checked -> onUpdate { it.copy(useOnDisconnect = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("启用 SSID 匹配", value.ssidMatching, { checked -> onUpdate { it.copy(ssidMatching = checked) } })
+                        MiuixDivider()
+                        MiuixSwitchRow("记录匹配日志", value.logEnabled, { checked -> onUpdate { it.copy(logEnabled = checked) } })
+                        MiuixDivider()
+                        MiuixPreferenceRow(
+                            title = "列表模式",
+                            value = if (value.listMode == "whitelist") "白名单" else "黑名单",
+                            enabledValueColor = true,
+                            onClick = { onUpdate { it.copy(listMode = if (it.listMode == "whitelist") "blacklist" else "whitelist") } },
+                        )
+                    }
+                }
+            }
+            item { ListEditor("SSID 列表", value.ssids.joinToString("\n")) { text -> onUpdate { it.copy(ssids = parseLines(text)) } } }
+            item { ListEditor("BSSID 列表", value.bssids.joinToString("\n")) { text -> onUpdate { it.copy(bssids = parseLines(text)) } } }
+            item { MiuixFilledButton(if (state.networkTools.saving) "正在保存…" else "保存并应用", onSave, enabled = !state.networkTools.saving) }
+        }
+    }
+}
