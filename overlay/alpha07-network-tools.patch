+@Composable
+private fun ListEditor(title: String, value: String, hint: String = "每行一项", onChange: (String) -> Unit) {
+    val tokens = LocalMiuixTokens.current
+    MiuixCard(strong = true) {
+        Column(Modifier.fillMaxWidth().padding(15.dp)) {
+            Text(title, color = tokens.textPrimary, fontSize = 16.sp, fontWeight = FontWeight.Black)
+            Spacer(Modifier.height(8.dp))
+            OutlinedTextField(
+                value = value,
+                onValueChange = onChange,
+                modifier = Modifier.fillMaxWidth(),
+                minLines = 5,
+                placeholder = { Text(hint) },
+                colors = editorColors(),
+            )
+        }
+    }
+}
+
+@Composable
+private fun SingleLineEditor(title: String, value: String, onChange: (String) -> Unit) {
+    val tokens = LocalMiuixTokens.current
+    MiuixCard(strong = true) {
+        Column(Modifier.fillMaxWidth().padding(15.dp)) {
+            Text(title, color = tokens.textPrimary, fontSize = 16.sp, fontWeight = FontWeight.Black)
+            Spacer(Modifier.height(8.dp))
+            OutlinedTextField(value = value, onValueChange = onChange, modifier = Modifier.fillMaxWidth(), singleLine = true, colors = editorColors())
+        }
+    }
+}
+
+@Composable
+private fun editorColors() = OutlinedTextFieldDefaults.colors(
+    focusedContainerColor = LocalMiuixTokens.current.neutralSoft.copy(alpha = .55f),
+    unfocusedContainerColor = LocalMiuixTokens.current.neutralSoft.copy(alpha = .55f),
+    focusedBorderColor = MaterialTheme.colorScheme.primary,
+    unfocusedBorderColor = LocalMiuixTokens.current.divider,
+)
+
+private fun parseLines(value: String): List<String> = value.lineSequence().map(String::trim).filter(String::isNotEmpty).distinct().toList()
