+@Composable
+fun SubscriptionManagerScreen(
+    state: SinanUiState,
+    onBack: () -> Unit,
+    onRefresh: () -> Unit,
+    onUpdate: (String) -> Unit,
+    onUpdateAll: () -> Unit,
+) {
+    val tokens = LocalMiuixTokens.current
+    MiuixPage(title = "订阅管理", onBack = onBack, contentPadding = PaddingValues(16.dp, 8.dp, 16.dp, 30.dp)) {
+        LazyColumn(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            item {
+                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    MiuixFilledButton("刷新", onRefresh, Modifier.weight(1f), enabled = !state.providersLoading)
+                    MiuixFilledButton("全部更新", onUpdateAll, Modifier.weight(1f), enabled = state.proxyProviders.isNotEmpty())
+                }
+            }
+            items(state.proxyProviders.size) { index ->
+                val provider = state.proxyProviders[index]
+                val update = state.proxyProviderUpdates[provider.name]
+                MiuixCard(strong = true) {
+                    Column(Modifier.fillMaxWidth().padding(15.dp)) {
+                        Row {
+                            Column(Modifier.weight(1f)) {
+                                Text(provider.name, color = tokens.textPrimary, fontSize = 17.sp, fontWeight = FontWeight.Black)
+                                Text("${provider.proxyCount} 个节点 · ${provider.vehicleType}", color = tokens.textSecondary, fontSize = 11.5.sp)
+                            }
+                            Text(
+                                when (update?.phase) {
+                                    ProviderUpdatePhase.UPDATING -> "更新中"
+                                    ProviderUpdatePhase.SUCCESS -> "成功"
+                                    ProviderUpdatePhase.ERROR -> "失败"
+                                    else -> "更新"
+                                },
+                                modifier = Modifier.padding(8.dp),
+                                color = MaterialTheme.colorScheme.primary,
+                                fontWeight = FontWeight.Bold,
+                            )
+                        }
+                        MiuixPreferenceRow(
+                            title = update?.message?.ifBlank { provider.updatedAt } ?: provider.updatedAt.ifBlank { "尚未更新" },
+                            showArrow = false,
+                            onClick = if (update?.phase == ProviderUpdatePhase.UPDATING) null else ({ onUpdate(provider.name) }),
+                        )
+                    }
+                }
+            }
+            if (state.proxyProviders.isEmpty()) item { Text("暂无订阅，请先启动代理并检查配置", color = tokens.textSecondary, modifier = Modifier.padding(12.dp)) }
+        }
+    }
+}
