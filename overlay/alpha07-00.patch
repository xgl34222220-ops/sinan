+package io.github.xgl34222220.sinan
+
+import android.Manifest
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.content.ContextCompat
+import io.github.xgl34222220.sinan.core.RuntimeState
+
+class RuntimeNotificationController(private val context: Context) {
+    private val manager = NotificationManagerCompat.from(context)
+
+    init {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            val channel = NotificationChannel(
+                CHANNEL_ID,
+                "司南运行状态",
+                NotificationManager.IMPORTANCE_LOW,
+            ).apply {
+                description = "显示透明代理运行状态、速度与快捷入口"
+                setShowBadge(false)
+            }
+            context.getSystemService(NotificationManager::class.java).createNotificationChannel(channel)
+        }
+    }
+
+    fun update(
+        runtime: RuntimeState,
+        traffic: TrafficUiState,
+        enabled: Boolean,
+        detailed: Boolean,
+        statusEntry: Boolean,
+    ) {
+        if (!enabled && !statusEntry) {
+            manager.cancel(NOTIFICATION_ID)
+            return
+        }
+        if (Build.VERSION.SDK_INT >= 33 &&
+            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) return
+
+        val contentIntent = PendingIntent.getActivity(
+            context,
+            0,
+            Intent(context, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val status = when {
+            runtime.running -> "透明代理运行中"
+            runtime.coreReady -> "透明代理已停止"
+            else -> "核心尚未安装"
+        }
+        val detail = if (detailed && runtime.running) {
+            "↑ ${formatRate(traffic.uploadSpeed)}  ↓ ${formatRate(traffic.downloadSpeed)} · ${traffic.activeConnections} 个连接"
+        } else {
+            "${runtime.mode} · ${runtime.configName}"
+        }
+        val notification = NotificationCompat.Builder(context, CHANNEL_ID)
+            .setSmallIcon(android.R.drawable.stat_sys_download_done)
+            .setContentTitle(status)
+            .setContentText(detail)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(detail))
+            .setContentIntent(contentIntent)
+            .setOngoing(statusEntry || runtime.running)
+            .setOnlyAlertOnce(true)
+            .setSilent(true)
+            .setCategory(NotificationCompat.CATEGORY_SERVICE)
+            .build()
+        manager.notify(NOTIFICATION_ID, notification)
+    }
+
+    fun cancel() = manager.cancel(NOTIFICATION_ID)
+
+    private fun formatRate(value: Long): String = when {
+        value >= 1024L * 1024L -> String.format("%.1f MB/s", value / (1024f * 1024f))
+        value >= 1024L -> String.format("%.1f KB/s", value / 1024f)
+        else -> "$value B/s"
+    }
+
+    companion object {
+        const val CHANNEL_ID = "sinan_runtime"
+        const val NOTIFICATION_ID = 1007
+    }
+}
