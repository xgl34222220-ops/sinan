+import io.github.xgl34222220.sinan.ui.components.MiuixPage
+import io.github.xgl34222220.sinan.ui.theme.LocalMiuixTokens
+
+private val strategyIconChoices = listOf(
+    "🚀", "⏩", "🟩", "🇭🇰", "🇹🇼", "🇯🇵", "🇸🇬", "🇰🇷", "🇺🇸", "🤖",
+    "▶️", "🎵", "✖️", "🎬", "🎮", "📺", "🌍", "📡", "🎯", "♾️",
+)
+
+@Composable
+fun StrategyIconScreen(
+    state: SinanUiState,
+    onBack: () -> Unit,
+    onSetIcon: (String, String) -> Unit,
+) {
+    var selected by remember { mutableStateOf<ProxyGroup?>(null) }
+    MiuixPage(
+        title = "策略图标",
+        onBack = onBack,
+        contentPadding = PaddingValues(16.dp, 6.dp, 16.dp, 28.dp),
+    ) {
+        LazyVerticalGrid(
+            columns = GridCells.Fixed(2),
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = PaddingValues(bottom = 16.dp),
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            items(state.groups, key = { it.name }) { group ->
+                StrategyIconCard(
+                    group = group,
+                    icon = state.strategyIcons[group.name] ?: inferStrategyIcon(group.name),
+                    onClick = { selected = group },
+                )
+            }
+        }
+    }
+
+    selected?.let { group ->
+        val tokens = LocalMiuixTokens.current
+        AlertDialog(
+            onDismissRequest = { selected = null },
+            shape = RoundedCornerShape(28.dp),
+            containerColor = tokens.elevatedCard,
+            title = { Text(group.name, color = tokens.textPrimary, fontWeight = FontWeight.Black) },
+            text = {
+                LazyVerticalGrid(
+                    columns = GridCells.Fixed(5),
+                    modifier = Modifier.height(300.dp),
+                    horizontalArrangement = Arrangement.spacedBy(7.dp),
+                    verticalArrangement = Arrangement.spacedBy(7.dp),
+                ) {
+                    items(strategyIconChoices) { icon ->
+                        Surface(
+                            modifier = Modifier.size(48.dp).clickable {
+                                onSetIcon(group.name, icon)
+                                selected = null
+                            },
+                            shape = RoundedCornerShape(14.dp),
+                            color = MaterialTheme.colorScheme.primary.copy(alpha = .08f),
+                        ) { Box(contentAlignment = Alignment.Center) { Text(icon, fontSize = 26.sp) } }
+                    }
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = { onSetIcon(group.name, ""); selected = null }) { Text("恢复自动") }
+            },
+            dismissButton = { TextButton(onClick = { selected = null }) { Text("取消") } },
+        )
+    }
+}
+
+@Composable
+private fun StrategyIconCard(group: ProxyGroup, icon: String, onClick: () -> Unit) {
+    val tokens = LocalMiuixTokens.current
+    MiuixCard(modifier = Modifier.height(104.dp), strong = true, onClick = onClick) {
+        Row(Modifier.fillMaxSize().padding(13.dp), verticalAlignment = Alignment.CenterVertically) {
+            Text(icon, fontSize = 31.sp)
+            Spacer(Modifier.size(10.dp))
+            Column(Modifier.weight(1f)) {
+                Text(group.name, color = tokens.textPrimary, fontSize = 15.sp, fontWeight = FontWeight.Black, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                Spacer(Modifier.height(3.dp))
+                Text(group.type, color = tokens.textSecondary, fontSize = 10.5.sp)
+                Text(group.current, color = tokens.textSecondary, fontSize = 10.5.sp, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            }
+        }
+    }
+}
+
+private fun inferStrategyIcon(name: String): String {
+    val lower = name.lowercase()
+    return when {
+        "香港" in name || "hong kong" in lower -> "🇭🇰"
+        "台湾" in name || "taiwan" in lower -> "🇹🇼"
+        "日本" in name || "japan" in lower -> "🇯🇵"
+        "新加坡" in name || "singapore" in lower -> "🇸🇬"
+        "韩国" in name || "korea" in lower -> "🇰🇷"
+        "美国" in name || "united states" in lower -> "🇺🇸"
+        "ai" in lower || "openai" in lower -> "🤖"
+        "youtube" in lower -> "▶️"
+        "tiktok" in lower || "抖音" in name -> "🎵"
+        "fallback" in lower || "故障" in name -> "🟩"
+        "手动" in name || "manual" in lower -> "⏩"
+        else -> "🚀"
+    }
+}
