+package io.github.xgl34222220.sinan.core
+
+import android.content.Context
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.zip.ZipInputStream
+
+class WebUiUpdater(
+    private val context: Context,
+    private val runtime: RuntimeManager,
+) {
+    fun update(onProgress: (Int) -> Unit = {}): String {
+        val targetZip = File(context.cacheDir, "metacubexd-${System.nanoTime()}.zip")
+        val connection = URL(DASHBOARD_ZIP).openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = 15_000
+            connection.readTimeout = 90_000
+            connection.instanceFollowRedirects = true
+            connection.setRequestProperty("User-Agent", "Sinan/${io.github.xgl34222220.sinan.BuildConfig.VERSION_NAME}")
+            val code = connection.responseCode
+            if (code !in 200..299) error("WebUI 下载返回 HTTP $code")
+            val total = connection.contentLengthLong
+            connection.inputStream.use { input ->
+                targetZip.outputStream().use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var copied = 0L
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        output.write(buffer, 0, read)
+                        copied += read
+                        if (total > 0) onProgress(((copied * 100L) / total).toInt().coerceIn(0, 100))
+                    }
+                }
+            }
+        } finally {
+            connection.disconnect()
+        }
+
+        val staging = File(context.cacheDir, "metacubexd-${System.nanoTime()}")
+        check(staging.mkdirs()) { "无法创建 WebUI 临时目录" }
+        try {
+            ZipInputStream(targetZip.inputStream().buffered()).use { zip ->
+                while (true) {
+                    val entry = zip.nextEntry ?: break
+                    val stripped = entry.name.substringAfter('/', "").trimStart('/')
+                    if (stripped.isBlank()) continue
+                    val output = File(staging, stripped)
+                    val safeRoot = staging.canonicalPath + File.separator
+                    check(output.canonicalPath.startsWith(safeRoot)) { "WebUI 压缩包包含非法路径" }
+                    if (entry.isDirectory) output.mkdirs() else {
+                        output.parentFile?.mkdirs()
+                        output.outputStream().use { zip.copyTo(it) }
+                    }
+                    zip.closeEntry()
+                }
+            }
+            val index = File(staging, "index.html")
+            check(index.isFile) { "WebUI 压缩包中没有 index.html" }
+            runtime.paths.webUi.deleteRecursively()
+            check(staging.copyRecursively(runtime.paths.webUi, overwrite = true)) { "写入 WebUI 目录失败" }
+            ensureConfigPointsToUi()
+            val applied = runtime.applyDatabaseChanges()
+            if (!applied.success) error(applied.output.ifBlank { "WebUI 已写入，但重载配置失败" })
+            return "MetaCubeX Dashboard 已更新"
+        } finally {
+            targetZip.delete()
+            staging.deleteRecursively()
+        }
+    }
+
+    private fun ensureConfigPointsToUi() {
+        val config = runtime.readConfig()
+        val updated = when {
+            Regex("(?m)^\\s*external-ui\\s*:").containsMatchIn(config) ->
+                config.replace(Regex("(?m)^\\s*external-ui\\s*:.*$"), "external-ui: ui")
+            else -> config.trimEnd() + "\nexternal-ui: ui\n"
+        }
+        val saved = runtime.saveConfig(updated)
+        if (!saved.success) error(saved.output.ifBlank { "无法更新 external-ui 配置" })
+    }
+
+    companion object {
+        private const val DASHBOARD_ZIP = "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"
+    }
+}
