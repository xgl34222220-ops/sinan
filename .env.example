TIANJI_DOMAIN=tianji-xgl.duckdns.org
TIANJI_PUBLIC_BASE_URL=https://tianji-xgl.duckdns.org
TIANJI_DATABASE=/app/data/tianji.db
TIANJI_API_TOKEN=replace-with-openssl-rand-hex-32
TIANJI_ADMIN_PASSWORD=replace-with-at-least-8-characters
TIANJI_POLL_SECONDS=30
TIANJI_HISTORY_DAYS=14

# Production hardening. Keep API docs disabled unless temporarily needed.
TIANJI_DOCS_ENABLED=false
TIANJI_LOGIN_MAX_FAILURES=5
TIANJI_LOGIN_WINDOW_SECONDS=600
TIANJI_LOGIN_LOCK_SECONDS=900

# Worker protection. A hard timeout exits the Worker; Docker restarts a clean process.
TIANJI_WORKER_CYCLE_TIMEOUT_SECONDS=240
TIANJI_WORKER_BACKOFF_MAX_SECONDS=600

# Automatic verified SQLite backups.
TIANJI_BACKUP_DIR=/app/backups
TIANJI_BACKUP_INTERVAL_SECONDS=86400
TIANJI_BACKUP_RETENTION_DAILY=7
TIANJI_BACKUP_RETENTION_MONTHLY=6

# Initial AI values. They can later be changed from /admin.
TIANJI_AI_ENDPOINT=https://api.deepseek.com/chat/completions
TIANJI_AI_MODEL=deepseek-chat
TIANJI_AI_API_KEY=
TIANJI_AI_TIMEOUT_SECONDS=120

# Unified Push Protocol v2.
TIANJI_PUSH_THRESHOLD=3
TIANJI_PUSH_DELIVERY_WORKERS=6
TIANJI_PUSH_RETRY_SECONDS=300
TIANJI_PUSH_DELIVERY_RETENTION_DAYS=45
TIANJI_PUSH_DEVICE_STALE_DAYS=90
TIANJI_FCM_PROJECT_ID=
TIANJI_FCM_SERVICE_ACCOUNT_B64=

# Telegram and FCM consume normalized event metadata.
TIANJI_TELEGRAM_BOT_TOKEN=
TIANJI_TELEGRAM_CHAT_IDS=
